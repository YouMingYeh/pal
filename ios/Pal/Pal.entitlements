<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>$(PAL_APNS_ENVIRONMENT)</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:pal-jade.vercel.app</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pal.spike</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.pal.spike.shared</string>
		<string>$(AppIdentifierPrefix)com.pal.spike</string>
	</array>
</dict>
</plist>
